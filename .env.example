# Copy to .env (VPS: `cp .env.example .env && nano .env`). Never commit real values. Used by docker-compose.yml (see deploy/README.md).
# For `pnpm dev` on your Mac nothing here is needed.

# ---------------------------------------------------------------- general
# Your timezone (IANA name). Used for "today" in the brief, BRIEF_TIME and quiet hours.
TZ=America/New_York

# ---------------------------------------------------------------- address / HTTPS
# Public host name. Needs a DNS A record: fantasy -> the VPS public IP (see deploy/README.md, step "DNS").
# Web Push (the iPhone notifications) REQUIRES https, so it requires a domain.
DOMAIN=fantasy.example.com
# `domain` starts Caddy (automatic HTTPS + login on the app and the remote browser).
# Delete or comment this line to run WITHOUT a domain: everything then listens on 127.0.0.1 only (SSH tunnel, no push).
COMPOSE_PROFILES=domain
# Login for the whole site (Caddy basic auth). Pick a long password.
BASIC_AUTH_USER=me
BASIC_AUTH_PASSWORD=change-me-to-a-long-password

# ---------------------------------------------------------------- Yahoo browser worker
# Your league and team ids: https://basketball.fantasysports.yahoo.com/nba/<LEAGUE_ID>/<TEAM_ID>
YAHOO_LEAGUE_ID=
YAHOO_TEAM_ID=
# Password for the remote browser (noVNC) window where YOU log in to Yahoo. Only the first 8 characters count; Caddy's login protects it too.
NOVNC_PASSWORD=change-me
# Shared secret for the worker's control endpoint (manual sync). Any long random string (`openssl rand -hex 24`).
WORKER_TOKEN=
# Sync every N hours +/- jitter minutes, at most N syncs per day. Optional quiet hours "HH:MM-HH:MM" (local time, no syncs then), e.g. 01:00-06:00.
# Each run reads all 14 teams, the matchup and the transactions; the full free-agent list only every 3 h (and on "Refresh data").
SYNC_EVERY_HOURS=1
SYNC_JITTER_MINUTES=10
MAX_SYNCS_PER_DAY=30
SYNC_QUIET_HOURS=
# While Yahoo wants a login, scheduled runs probe again at most every N hours; the "log in again" alert repeats at most every N hours.
LOGIN_RETRY_HOURS=6
LOGIN_ALERT_REPEAT_HOURS=12
# Only if the link in the alert should differ from https://$DOMAIN/browser/vnc.html?autoconnect=1&resize=scale&path=browser/websockify
NOVNC_PUBLIC_URL=

# ---------------------------------------------------------------- notifications (iPhone push)
# Generate ONCE with `pnpm push:vapid` (or `docker compose run --rm scheduler node_modules/.bin/tsx scripts/push-vapid.ts`) and paste here.
# Changing the keys later invalidates every subscribed device.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Optional filter: "webpush", "email" or "webpush,email". Empty = every configured channel (push always; e-mail only if SMTP below is set).
NOTIFY_CHANNELS=
# Optional secondary channel: e-mail. Leave SMTP_HOST empty to keep it off.
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (port 465); empty/false = STARTTLS
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# one or more addresses, comma separated
SMTP_TO=

# ---------------------------------------------------------------- Claude analysis (your subscription, not the API)
# Run `claude setup-token` (on your Mac or the VPS) and paste the 1-year token here.
CLAUDE_CODE_OAUTH_TOKEN=
# The date you created the token (YYYY-MM-DD). A warning is pushed 14 days before it expires (1 year).
CLAUDE_TOKEN_CREATED=
# NEVER set ANTHROPIC_API_KEY for this deployment: it would take precedence and bill the API. It is not passed to any container.
# Optional model alias (e.g. sonnet, opus); empty = the CLI default.
CLAUDE_MODEL=
# Optional extra CLI flags, space separated (e.g. "--permission-prompts none" if your CLI version has that flag).
CLAUDE_EXTRA_ARGS=
CLAUDE_TIMEOUT_SECONDS=300

# ---------------------------------------------------------------- schedule
# Morning brief, local time (TZ above). A fresh Yahoo sync is requested first (BRIEF_SYNC_FIRST=0 to skip).
BRIEF_TIME=08:30
BRIEF_SYNC_FIRST=1
# On this weekday the morning message is the longer weekly strategy plan instead of the daily brief (empty = never).
WEEKLY_PLAN_DAY=Mon
# Separate injury push alerts every N minutes (0 = off; injuries still shape the moves in the briefs). INJURY_CLAUDE=0 = engine facts only.
INJURY_WATCH_MINUTES=0
INJURY_CLAUDE=1
# Daily upkeep inside the app (schedule, news, stored brief). Leave on.
SEASON_AUTO_REFRESH=1
NEWS_AUTO_REFRESH=1

# ---------------------------------------------------------------- optional / legacy (local use only, not used by the containers)
# SQLite file for `pnpm dev` (default ./data/fantasy.sqlite)
# DB_FILE_NAME=./data/fantasy.sqlite
# Yahoo Fantasy API (the app works without it). Register an app at https://developer.yahoo.com/apps/ with "Fantasy Sports: Read".
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=oob
# YAHOO_TOKEN_FILE=data/yahoo-tokens.json
