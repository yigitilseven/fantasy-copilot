# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
data/*.sqlite*

# playwright
/test-results/
/playwright-report/

# yahoo oauth tokens (secrets)
data/yahoo-tokens.json
data/yahoo-tokens.json.tmp
data/backup-*/

# real-data importer raw response cache
data/cache/

# always-on deployment runtime output
data/reports/
data/ops/

.claude/
